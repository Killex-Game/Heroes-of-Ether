# Это отдельное окружение backup-пользователя, НЕ переменные браузерной игры.
BACKUP_ENABLED=false
PGSERVICE=sferorumiya_backup
PGSERVICEFILE=/etc/sferorumiya/pg_service.conf
PGPASSFILE=/etc/sferorumiya/pgpass
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/sferorumiya/postgres-ca.pem
AGE_RECIPIENT=REPLACE_PUBLIC_AGE_RECIPIENT
S3_ENDPOINT=https://REPLACE_S3_ENDPOINT
S3_BUCKET=REPLACE_PRIVATE_BACKUP_BUCKET
AWS_ACCESS_KEY_ID=REPLACE_UPLOAD_ONLY_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_UPLOAD_ONLY_SECRET
AWS_DEFAULT_REGION=REPLACE_STORAGE_REGION
AWS_EC2_METADATA_DISABLED=true
# pg_service.conf: [sferorumiya_backup], host, port=5432, dbname, user, sslmode=verify-full.
# pgpass: host:5432:dbname:user:password, chmod 600. Оба файла вне Git.
# Закрытый ключ age хранить у владельца отдельно от игрового сервера.
# Backup-роль БД: CONNECT + USAGE schema + SELECT таблиц/sequence, без записи.
# S3-роль: PutObject в snapshots/ и разрешения multipart при необходимости,
# без удаления/управления bucket. Lifecycle хранит snapshots/ 30 дней.
