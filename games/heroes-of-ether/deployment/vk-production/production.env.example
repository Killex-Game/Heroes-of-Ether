# ПРОЕКТ переменных будущего production entrypoint. Нынешний server.js их НЕ читает.
# Историческая заготовка PostgreSQL. С 10.11.2026 рабочий MongoDB настраивается
# через config/mongodb.local.json; см. docs/architecture-advice-20261110.md.
# Не включать этот файл как конфигурацию действующей игры.
# Изменить enabled недостаточно: сначала реализовать интеграцию из developer-guide.md.
MULTIPLAYER_ENABLED=false
GAME_ENV=staging
VK_PLATFORM=vk-games
VK_APP_ID=REPLACE_FROM_VK_GAME_SETTINGS
VK_APP_SECRET=REPLACE_ON_SERVER_ONLY
GAME_PUBLIC_ORIGIN=https://game.example.invalid
MOCK_PAYMENTS_ENABLED=false
TEST_BOTS_ENABLED=false
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_PRIVATE_HOST:5432/sferorumiya
PGSSLROOTCERT=/etc/sferorumiya/postgres-ca.pem
PGSSLMODE=verify-full
SESSION_SIGNING_KEY=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES
ARENA_POLICY_PATH=/opt/sferorumiya/deployment/vk-production/arena-policy.json
WORKER_NODE_ID=REPLACE_UNIQUE_NODE_NAME
WORKER_RPC_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET
# Настоящие значения хранить вне репозитория, например /etc/sferorumiya/production.env.
# Database pool: начать с 10 соединений на API/worker-процесс, общий бюджет <= 80.
# Сначала определить реальные процессы и лимит Managed PostgreSQL.
